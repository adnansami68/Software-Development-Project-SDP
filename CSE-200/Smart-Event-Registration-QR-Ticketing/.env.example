# Local development configuration. Copy this file to .env.
# Never commit .env or paste its secrets into chats or screenshots.
SECRET_KEY=replace-with-a-random-secret
APP_NAME=EventPass
APP_BASE_URL=http://127.0.0.1:5000
TIMEZONE=Asia/Dhaka
AUTO_CREATE_DB=true

# Local SQLite database. Vercel production must use PostgreSQL (Neon/Supabase).
DATABASE_URL=sqlite:///eventpass.db

# SMTP settings. Gmail requires a Google App Password, not your normal password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_SUPPRESS_SEND=false
MAIL_TIMEOUT=15

# Local HTTP does not use secure cookies. Vercel HTTPS must set this to true.
SESSION_COOKIE_SECURE=false
