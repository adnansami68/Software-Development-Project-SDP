# Copy to .env.production locally, or configure these in Vercel Project Settings.
# Use the DIRECT PostgreSQL connection string here for the one-time local schema/admin commands.
# In Vercel, set DATABASE_URL to Neon's POOLED URL (hostname contains -pooler).
SECRET_KEY=replace-with-a-new-random-secret
APP_NAME=EventPass
APP_BASE_URL=https://YOUR-PROJECT.vercel.app
TIMEZONE=Asia/Dhaka
AUTO_CREATE_DB=false
DATABASE_URL=postgresql://USER:PASSWORD@DIRECT-HOST.REGION.aws.neon.tech/DBNAME?sslmode=require

# SMTP provider credentials. Use a transactional email provider for production.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_SUPPRESS_SEND=false
MAIL_TIMEOUT=15
SESSION_COOKIE_SECURE=true
